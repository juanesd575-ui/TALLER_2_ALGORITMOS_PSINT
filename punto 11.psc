Algoritmo intervalos
	definir num Como Real
	Escribir "digite un numero para hallar su intervalo"
	leer num
	si num < 20 Entonces
		Escribir "el numero: ", num, " esta en el intervalo de los menores a 20"
	FinSi
	si num >= 20 y num <= 50 Entonces
		Escribir "el numero: ", num, " esta en el intervalo de 20-50"
	FinSi
	si num >= 50 y num <= 69 Entonces
		Escribir "el numero: ", num, " esta en el intervalo de 51-69"
	FinSi
	si num >= 70 y num <= 120 Entonces
		Escribir "el numero: ", num, " esta en el intervalo de 70-120"
	FinSi
	si num >= 121 y num <= 149 Entonces
		Escribir "el numero: ", num, " esta en el intervalo de 121-149"
	FinSi
	si num >= 150 y num <= 300 Entonces
		Escribir "el numero: ", num, " esta en el intervalo de 150-300"
	FinSi
	si num > 300 Entonces
		Escribir "el numero: ", num, " no esta en ningun intervalo"
	FinSi
	
FinAlgoritmo
