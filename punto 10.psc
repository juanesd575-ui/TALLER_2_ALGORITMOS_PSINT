Algoritmo temperatura
	definir grados como real
	Escribir  "digite los grados centigrados"
	leer grados
	si grados <= 10 Entonces
		Escribir "el tipo de clima es frio"
	FinSi
	si grados >10 y grados <= 20 Entonces
		Escribir "el tipo de clima es nublado"
	FinSi
	si grados >20 y grados <= 30 Entonces
		Escribir "el tipo de clima es caluroso"
	FinSi
	si grados >30 Entonces
		Escribir "el tipo de clima es tropical"
	FinSi
FinAlgoritmo