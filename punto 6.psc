Algoritmo estatura
	definir Altura Como Real
	Escribir  "digite su altura en cm"
	leer Altura
	si Altura <= 150 Entonces
		Escribir "eres una persona de altura baja"
	FinSi
	si altura >= 151 y Altura <= 170 Entonces
			Escribir  "eres una persona de altura media"			
		FinSi
		si Altura > 171
			Escribir  "eres una persona alta"
		FinSi
FinAlgoritmo